<template>
  <div class="page" style="{{sPage}}" onswipe="onSwipe">
    <!-- 立绘模式：整屏立绘 + 浮在下方的小气泡。
         这一层铺满整个画布（绝对定位），所以顶栏/底栏浮出来时立绘不会跳。
         长按任意位置 → 顶栏底栏浮出来（5 秒后自动收起）；开启调整后拖动可移动立绘。
         ★ 必须放在 .page 的第一个子节点：绝对定位层如果排在顶栏后面，
           会盖在顶栏上面把消息按钮的点击吞掉。 -->
    <div class="tlayer" if="{{tachieOn}}" style="{{sTLayer}}"
      ontouchstart="onDragStart" ontouchmove="onDragMove" ontouchend="onDragEnd">
      <image class="tachie" src="{{tachieSrc}}" style="{{sTachie}}" />
      <div class="tbubble" if="{{showBubble}}" style="{{sTBubble}}">
        <text class="tbubble-text" style="{{sTText}}">{{dispText}}</text>
      </div>
    </div>

    <!-- 顶部：信息 + 时钟 + 好感度；右滑退出。
         两套结构用 if 切换（不用动态 class 改 flex-direction —— 原生渲染下样式重排不可靠）：
         宽屏一行放得下，窄屏（手环 10）消息按钮单独一行、时间+好感换到第二行。 -->
    <div class="topbar {{barCls}}" if="{{topWide}}" style="{{sTopbar}}">
      <div class="btn" style="{{sBtn}}" onclick="onInbox" onlongpress="onExit">
        <image class="ico" src="/common/img/ic_msg.png" style="{{sIco}}" />
        <div class="dot" if="{{hasUnread}}" style="{{sDot}}"></div>
      </div>
      <text class="clock" style="{{sClock}}">{{clock}}</text>
      <div class="affchip {{affCls}}" style="{{sAff}}">
        <text class="aff-t" style="{{sAffT}}">{{affText}}</text>
      </div>
      <text class="afftip" style="{{sAffTip}}">{{affTip}}</text>
    </div>

    <div class="topbar topbar-col {{barCls}}" if="{{topNarrow}}" style="{{sTopbar}}">
      <div class="btn" style="{{sBtn}}" onclick="onInbox" onlongpress="onExit">
        <image class="ico" src="/common/img/ic_msg.png" style="{{sIco}}" />
        <div class="dot" if="{{hasUnread}}" style="{{sDot}}"></div>
      </div>
      <div class="row2" style="{{sTopRow2}}">
        <text class="clock" style="{{sClockN}}">{{clock}}</text>
        <div class="affchip {{affCls}}" style="{{sAff}}">
          <text class="aff-t" style="{{sAffT}}">{{affText}}</text>
        </div>
        <text class="afftip" style="{{sAffTip}}">{{affTip}}</text>
      </div>
    </div>

    <!-- 表情包模式：整块可点区域（表情 + 文字都在里面，点哪都说话） -->
    <div class="playarea" if="{{emojiOn}}" style="{{sPlay}}" onclick="onTap">
      <div class="stage" style="{{sStage}}">
        <div class="card" style="{{sHalo}}">
          <image class="avatar" src="{{emojiSrc}}" style="{{sAvatar}}" />
        </div>
      </div>
      <div class="bubble" style="{{sBubble}}">
        <text class="bubble-text" style="{{sText}}">{{dispText}}</text>
      </div>
    </div>

    <!-- 底栏 A：表情包模式 —— 跟随流布局，所以键不能太大（会把舞台压扁）。
         支持立绘的机型多一个「切换」键；手环 10 不做立绘，只剩设置键。 -->
    <div class="bottombar" if="{{showBarNormal}}" style="{{sBottombar}}">
      <div class="btn" if="{{showSwap}}" style="{{sBtn}}" onclick="onToggleMode">
        <image class="ico" src="/common/img/ic_swap.png" style="{{sIco}}" />
      </div>
      <div class="btn" if="{{showSwap}}" style="{{sBtnM}}" onclick="onSettings">
        <image class="ico" src="/common/img/ic_set.png" style="{{sIco}}" />
      </div>
      <div class="btn" if="{{noSwap}}" style="{{sBtn}}" onclick="onSettings">
        <image class="ico" src="/common/img/ic_set.png" style="{{sIco}}" />
      </div>
    </div>

    <!-- 底栏 B：立绘模式 —— 绝对定位贴底，不参与流布局，所以能放开做三个大键。
         默认整条隐藏，长按屏幕才浮出来。 -->
    <div class="bottombar bottombar-abs" if="{{showBarTachie}}" style="{{sBottombarT}}">
      <div class="btn" style="{{sBtnBig}}" onclick="onToggleMode">
        <image class="ico" src="/common/img/ic_swap.png" style="{{sIcoBig}}" />
      </div>
      <div class="btn" style="{{sBtnBigM}}" onclick="onAdjust">
        <image class="ico" src="/common/img/ic_adjust.png" style="{{sIcoBig}}" />
      </div>
      <div class="btn" style="{{sBtnBigM}}" onclick="onSettings">
        <image class="ico" src="/common/img/ic_set.png" style="{{sIcoBig}}" />
      </div>
    </div>

    <!-- 调整面板：拖动立绘改位置 + 滑条改大小 -->
    <div class="apanel" if="{{adjusting}}" style="{{sAPanel}}">
      <text class="atip" style="{{sATip}}">拖动立绘调位置</text>
      <div class="slider" style="{{sSlider}}"
        ontouchstart="onSliderStart" ontouchmove="onSliderMove" ontouchend="onSliderEnd">
        <div class="strack" style="{{sTrack}}"></div>
        <div class="sfill" style="{{sFill}}"></div>
        <div class="sknob" style="{{sKnob}}"></div>
      </div>
      <div class="abtns" style="{{sABtns}}">
        <div class="abtn" style="{{sABtn0}}" onclick="onViewReset">
          <text class="abtn-t" style="{{sABtnT}}">复位</text>
        </div>
        <div class="abtn abtn-main" style="{{sABtn}}" onclick="onAdjustDone">
          <text class="abtn-t" style="{{sABtnT}}">完成</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'
import device from '@system.device'
import { TARGET } from '../../config/device-target.js'
import { WELCOME, LOGIN_LINES, LEVEL_UP_LINES, TIME_LINES, MEAL_LINES, HEART_LINES,
  CHEER_LINES, SONG_LINES, CHAT_LINES, EXPR_LINES, BOND_LINES, DATE_LINES } from '../../config/dialogue.js'
import { maybeTrigger, unreadCount, loadState } from '../../config/inbox.js'
import { eventsOf } from '../../config/dates.js'
import { EMOJI, EMOJI_HI, framesOf, emojiPath } from '../../config/emoji.js'
import { exprFor } from '../../config/mood.js'
import { CHARACTER } from '../../config/character.js'
import { ITEMS as TACHIE_ITEMS, ASPECT, DEFAULT_VIEW, SIZE_MIN, SIZE_MAX, POS_LO, POS_HI,
  hasTachie, tachiePath, diffIdFor, loadView, saveView, VIEW } from '../../config/tachie.js'
import { dailyLogin, touchSlot, levelOf, effAff, isDev, loadAff } from '../../config/affinity.js'

const DW = 480               // 与 manifest.config.designWidth 保持一致
/* 表情清单统一在 config/emoji.js（新 20 套 10 帧 / 旧 10 套 8 帧） */
const EXPR = EMOJI
const EXPR_HI = EMOJI_HI
const TICK = 60              // 主循环间隔 ms
const FRAME_TICKS = 2        // 每 2 个 tick 换一帧表情（≈120ms，10 帧一轮 1.2 秒，接近源 GIF 速度）
const CHROME_HOLD = 84       // 立绘模式下顶栏/底栏浮出来后多久自动收起（84 tick ≈ 5 秒）
const LONG_MS = 500         // 按住多久算长按（到点立即触发，不是抬手才判）
/* 换差分时的「抖一下」：8 个 tick ≈ 0.48 秒，上下交替、幅度线性衰减到 0。
   0.022 在红米手表 5 上起始是 ±11 设计 px ≈ ±10 物理 px —— 明显但不夸张。 */
const SHAKE_TICKS = 8
const SHAKE_AMP = 0.022
/* 触发判定节流：8 分钟内不重复掷骰子。
   新机制是「每次登录 1/n 概率」，不节流的话在几个页面之间来回切
   就能把每天的 3 条额度刷完，体验会变成「一打开就全冒出来」。 */
const TRY_GAP = 8 * 60 * 1000
let lastTry = 0

/**
 * 把「立绘中心」夹到合法范围，返回实际能用的偏移量。
 *
 * 两种情形必须分开算，否则放大后会「拖不到底」：
 *   · 图比画布小 —— 整张图都得在画布内，偏移范围 [0, canvas - size]
 *   · 图比画布大 —— 至少铺满画布不留空白，偏移范围 [canvas - size, 0]
 *
 * 之前写死成 [-size*0.6, canvas - size*0.4]，在 3 倍放大时下面那截永远拖不出来。
 */
function clampOffset(v, size, canvas) {
  if (size <= canvas) return Math.min(Math.max(v, 0), canvas - size)
  return Math.min(Math.max(v, canvas - size), 0)
}

export default {
  private: {
    clock: '',
    fullText: CHARACTER.tapHint,
    dispText: CHARACTER.tapHint,
    emojiSrc: emojiPath('idle', 0),

    // 布局（applySizes 会按机型分辨率重算）
    cw: DW,
    ch: 540,
    k: 1,
    fs: 20,
    bubbleW: 384,
    bubbleH: 52,
    fitN: 12,
    scrollSrc: '',
    marquee: true,
    marqPos: 0,
    marqTick: 0,
    sPage: '', sTopbar: '', sTopRow2: '', narrow: false, wide: true,
    sBtn: '', sBtnM: '', sIco: '', sClock: '', sClockN: '',
    sBtnBig: '', sBtnBigM: '', sIcoBig: '', sBottombarT: '',
    sPlay: '', sStage: '', sHalo: '', sAvatar: '',
    sBubble: '', sText: '', sBottombar: '', sDot: '',
    sAff: '', sAffT: '', sAffTip: '',
    hasUnread: false,

    // 视图模式：emoji = 表情包 / tachie = 立绘
    mode: 'emoji',
    emojiOn: true,
    tachieOn: false,
    canTachie: false,        // 这台机器支不支持立绘模式（手环 10 不支持）
    showBarNormal: true,     // 表情包模式那条常驻底栏
    showBarTachie: false,    // 立绘模式那条长按浮出的底栏
    showSwap: false,         // 表情包底栏里要不要出现「切换」键
    noSwap: true,
    barCls: '',              // 立绘模式下给顶栏底栏加一层深色底衬
    chromeOn: false,         // 立绘模式下长按浮出来的状态
    chromeTicks: 0,
    adjusting: false,        // 调整面板是否打开
    showBubble: true,        // 调整面板打开时把气泡藏起来，面板才干净
    topWide: true,
    topNarrow: false,

    // 立绘：位置与大小（sizeR / posX / posY 会存档）
    tachieSrc: '',
    tachieId: '',
    sizeR: DEFAULT_VIEW.size,
    posX: DEFAULT_VIEW.x,
    posY: DEFAULT_VIEW.y,
    tw: 0, th: 0,
    baseLeft: 0, baseTop: 0, // 不含抖动偏移的基准位置
    shakeY: 0,               // 换差分抖动的当前偏移（设计 px）
    shakeTick: 0,            // 还剩几帧，0 = 静止
    tbW: 0, tbH: 0,
    sTLayer: '', sTachie: '', sTBubble: '', sTText: '',
    sAPanel: '', sATip: '', sSlider: '', sTrack: '', sFill: '', sKnob: '',
    sABtns: '', sABtn: '', sABtn0: '', sABtnT: '',
    trackLeft: 0, trackW: 0, knobD: 0,

    // 手势
    dragOn: false,
    dragMoved: false,
    dragT0: 0,
    longTimer: 0,            // 长按定时器（按住 500ms 到点就触发，不等抬手）
    longFired: false,        // 本次触摸里长按已经触发过了，抬手别再当点击
    dragX: 0,
    dragY: 0,
    sliderOn: false,

    // 好感度
    aff: 0,
    affState: null,
    level: null,
    dev: false,
    affText: 'Lv.1 0',
    affCls: 'aff-lo',
    affTip: '',
    affTipTicks: 0,

    // 运行时状态
    nick: '你',
    animOn: true,
    speed: 1,
    idleOn: true,
    expr: 'idle',
    frame: 0,
    tick: 0,
    lastAct: 0,
    welcomed: false,
    timer: null
  },

  onInit() {
    const self = this
    this.lastAct = new Date().getTime()
    this.clock = this.fmtClock()
    // canTachie 在 applySizes 里按真实屏宽算（手环 10 不做立绘模式）
    this.tachieId = diffIdFor('idle')
    this.tachieSrc = tachiePath(this.tachieId)
    this.applySizes(TARGET.W, TARGET.H)           // 先用写死分辨率兜底
    // 再用设备真实屏幕精修：避免写死分辨率与真机不符导致页面过大 / 可滑动
    try {
      device.getInfo({
        success(ret) {
          if (ret && ret.screenWidth && ret.screenHeight) {
            self.applySizes(ret.screenWidth, ret.screenHeight)
          }
        },
        fail() {}
      })
    } catch (e) {}
    // 上次用的是立绘还是表情包、立绘调到了多大/哪个位置
    loadView(function (v) {
      self.sizeR = v.size
      self.posX = v.x
      self.posY = v.y
      self.setMode(v.mode)
    })
    // 好感度：结算每日登录（加好感 + 说一句问候）
    this.bootAff()
  },

  onReady() {
    this.startLoop()
  },

  onShow() {
    this.clock = this.fmtClock()
    this.refreshAff()                              // 从聊天页结算完返回，数字要立刻对上
    this.refreshInbox()
    if (!this.timer) this.startLoop()
  },

  onHide() {
    this.stopLoop()
    this.clearLong()
  },

  onDestroy() {
    this.stopLoop()
    this.clearLong()
  },

  /* ---------------- 布局 ---------------- */

  applySizes(sw, sh) {
    if (!sw || !sh) return
    const k = DW / sw                       // 1 物理 px 对应多少 CSS px
    const cw = DW
    const ch = Math.round(sh * k)
    const landscape = sh < sw               // 横屏机型（如手环 10 Pro）

    /* 这台机器支不支持立绘模式：手环 10（212 宽）是竖长条，全身立绘没有能看的摆法，
       直接不做。存档里记着 tachie 也要回落到表情包，否则会显示一片空白。 */
    this.canTachie = hasTachie(sw)
    if (!this.canTachie && this.tachieOn) {
      this.mode = 'emoji'
      this.tachieOn = false
      this.emojiOn = true
      this.adjusting = false
      this.showBubble = true
      this.chromeOn = false
    }

    const btnPhys = Math.min(Math.max(sw * 0.1, 40), 54)
    const btn = Math.round(btnPhys * k)
    const ico = Math.round(btn * 0.5)
    const fsPhys = Math.min(Math.max(sw * 0.042, 12), 18)
    const fs = Math.round(fsPhys * k)

    const pad = Math.round(ch * 0.03)
    const affH = Math.round(fs * 1.5)
    /* 窄屏（手环 10，212 宽）：消息按钮 + 时钟 + 好感胶囊挤在一行会顶到边缘，
       拆成两行 —— 第一行只有消息按钮，第二行放时间与好感，整组仍水平居中。 */
    const narrow = sw < 280
    const rowGap = Math.round(fs * 0.3)
    const topH = narrow ? (btn + rowGap + affH + pad * 2) : (btn + pad * 2)
    const botH = btn + pad * 2
    const gap = Math.round(fs * 0.5)
    const bubbleH = Math.round(Math.min(fs * 2.4, ch * 0.15))
    const stageH = Math.max(70, ch - topH - botH - bubbleH - gap)
    // 表情包不超过舞台短边的 92%，也不超过画面宽度的 50%，避免“太大”
    // 窄屏（手环 10）表情放大到短边 82%；宽屏维持 50%
    const emRatio = sw < 280 ? 0.82 : 0.5
    const emoji = Math.round(Math.min(cw * emRatio, stageH * 0.92))
    const card = Math.round(emoji * 1.08)        // 光晕底框，比表情略大
    const bubbleW = cw - Math.round(cw * 0.16)

    this.cw = cw
    this.ch = ch
    this.fs = fs
    this.bubbleW = bubbleW
    this.bubbleH = bubbleH

    // 页面尺寸用 px 写死（不依赖 100%），从根上锁死画布，杜绝可滑动
    this.sPage = 'width:' + cw + 'px;height:' + ch + 'px;position:absolute;left:0;top:0;overflow:hidden;'

    this.narrow = narrow
    this.wide = !narrow
    this.sTopbar = 'height:' + topH + 'px;padding-left:' + pad + 'px;padding-right:' + pad + 'px;'
    this.sTopRow2 = narrow ? ('height:' + affH + 'px;margin-top:' + rowGap + 'px;') : ''
    this.sBottombar = 'height:' + botH + 'px;'
    this.sBtn = 'width:' + btn + 'px;height:' + btn + 'px;border-width:1px;border-color:rgba(255,255,255,0.13);border-radius:' + Math.round(btn / 2) + 'px;'
    this.sDot = 'width:' + Math.round(btn * 0.26) + 'px;height:' + Math.round(btn * 0.26) +
      'px;border-width:1px;border-color:rgba(255,255,255,0.13);border-radius:' + Math.round(btn * 0.13) + 'px;'
    this.sIco = 'width:' + ico + 'px;height:' + ico + 'px;'
    // 时钟必须显式 line-height，否则设备默认行高会把它顶偏、两行布局高度对不上
    // 窄屏时它是第二行的行首，左边距要去掉，否则整组看起来偏右
    const clockFs = Math.round(fs * 1.15)
    const clockLh = Math.round(fs * 1.5)
    this.sClock = 'font-size:' + clockFs + 'px;line-height:' + clockLh +
      'px;margin-left:' + Math.round(fs * 0.7) + 'px;'
    this.sClockN = 'font-size:' + clockFs + 'px;line-height:' + clockLh + 'px;'
    this.sAff = 'height:' + affH + 'px;border-width:1px;border-color:rgba(255,255,255,0.13);border-radius:' + Math.round(affH / 2) + 'px;margin-left:' +
      Math.round(fs * 0.5) + 'px;padding-left:' + Math.round(fs * 0.45) +
      'px;padding-right:' + Math.round(fs * 0.45) + 'px;'
    this.sAffT = 'font-size:' + Math.round(fs * 0.72) + 'px;line-height:' + affH + 'px;'
    this.sAffTip = 'font-size:' + Math.round(fs * 0.72) + 'px;line-height:' + affH + 'px;margin-left:' + Math.round(fs * 0.3) + 'px;'
    this.sPlay = 'width:100%;'
    this.sStage = 'width:100%;height:' + stageH + 'px;'
    // 光晕与表情改为流式居中（不再用绝对定位 left/top），避免 stage 0 宽把表情挤出屏外
    // 大圆角：卡片 0.32、里面那张图 0.22（旧 10 套表情自带浅色方底，靠它把方角磨圆）
    this.sHalo = 'width:' + card + 'px;height:' + card + 'px;border-width:1px;border-color:rgba(255,255,255,0.14);border-radius:' + Math.round(card * 0.32) + 'px;'
    this.sAvatar = 'width:' + emoji + 'px;height:' + emoji + 'px;border-width:1px;border-color:rgba(255,255,255,0.06);border-radius:' +
      Math.round(emoji * 0.22) + 'px;'
    this.sBubble = 'height:' + bubbleH + 'px;width:' + bubbleW + 'px;border-width:1px;border-color:rgba(255,255,255,0.14);border-radius:' +
      Math.round(bubbleH * 0.5) + 'px;margin-top:' + gap + 'px;'
    this.sText = 'font-size:' + fs + 'px;line-height:' + bubbleH + 'px;height:' + bubbleH + 'px;'

    /* 表情包底栏：切换 + 设置，靠 margin 拉开间距 */
    this.sBtnM = this.sBtn + 'margin-left:' + Math.round(btn * 0.55) + 'px;'

    /* ---- 立绘模式 ---- */

    /* 立绘底栏是绝对定位的，不挤占流布局，所以能放开手做大键。
       之前三个键挤在 btn*0.42 的间距里，实机上很难点准。 */
    const bigPhys = Math.min(Math.max(sw * 0.135, 48), 66)
    const big = Math.round(bigPhys * k)
    const bigIco = Math.round(big * 0.52)
    const bigGap = Math.round(big * 0.55)
    const tbarH = big + pad * 2
    this.sBtnBig = 'width:' + big + 'px;height:' + big + 'px;border-width:1px;border-color:rgba(255,255,255,0.13);border-radius:' + Math.round(big / 2) + 'px;'
    this.sBtnBigM = this.sBtnBig + 'margin-left:' + bigGap + 'px;'
    this.sIcoBig = 'width:' + bigIco + 'px;height:' + bigIco + 'px;'
    this.sBottombarT = 'width:' + cw + 'px;height:' + tbarH + 'px;left:0;top:' + (ch - tbarH) + 'px;'

    /* 铺满画布的绝对定位层 + 浮在立绘底栏上方的气泡 */
    this.k = k
    const tbH = Math.round(fs * 2.4)
    const tbW = Math.round(cw * 0.74)
    const tbGap = Math.round(ch * 0.02)
    this.tbW = tbW
    this.tbH = tbH
    this.sTLayer = 'width:' + cw + 'px;height:' + ch + 'px;left:0;top:0;'
    // 气泡固定在「立绘底栏上方」—— 底栏浮出来时不会盖住它，也不会因为底栏出现而跳动
    this.sTBubble = 'height:' + tbH + 'px;width:' + tbW + 'px;left:' + Math.round((cw - tbW) / 2) +
      'px;top:' + (ch - tbarH - tbGap - tbH) + 'px;border-width:1px;border-color:rgba(255,255,255,0.14);border-radius:' +
      Math.round(tbH * 0.5) + 'px;'

    this.layoutTachie()
    this.layoutAdjust()
    this.syncChrome()
    this.relayoutText()
  },

  /* 立绘的尺寸/位置：高度占画布高的 sizeR，宽度按 ASPECT 推，中心落在 (posX, posY) */
  layoutTachie() {
    const cw = this.cw || DW
    const ch = this.ch || 540
    const h = Math.round(ch * this.sizeR)
    const w = Math.round(h * ASPECT)
    this.tw = w
    this.th = h
    const lx = clampOffset(this.posX * cw - w / 2, w, cw)
    const ty = clampOffset(this.posY * ch - h / 2, h, ch)
    // 把夹完的实际位置写回去 —— 不然手指拖到边界之后，得先拖完等量的「空程」图才动
    this.posX = (lx + w / 2) / cw
    this.posY = (ty + h / 2) / ch
    this.baseLeft = Math.round(lx)
    this.baseTop = Math.round(ty)
    this.renderTachie()
  },

  /* 真正写进 style 的地方只有这里 —— 抖动只是给 baseTop 加一个偏移。
     立绘是透明底，背景纯黑，上下移动时看不出任何边界。 */
  renderTachie() {
    this.sTachie = 'width:' + this.tw + 'px;height:' + this.th + 'px;left:' + this.baseLeft +
      'px;top:' + (this.baseTop + this.shakeY) + 'px;'
  },

  /* 换完差分抖一下。连续快速点击时重新从最大幅度开始，不会越抖越弱。 */
  startShake() {
    this.shakeTick = SHAKE_TICKS
  },

  /* 调整面板：提示行 + 自定义滑条（轨道 / 已填充 / 圆钮）+ 两个按钮 */
  layoutAdjust() {
    const cw = this.cw || DW
    const ch = this.ch || 540
    const fs = this.fs || 20
    const pad = Math.round(fs * 0.8)
    // 底部要额外让一截：红米手表 5 的屏幕圆角半径是 90 物理 px，
    // 按钮贴着屏幕底边会被圆弧啃掉两个角。
    const padB = Math.max(pad, Math.round(ch * 0.045))
    const tipH = Math.round(fs * 1.8)
    const knob = Math.round(fs * 2.2)                 // 圆钮得能用一指点住
    const sliderH = Math.round(knob * 1.35)
    // 按钮按字号的 3 倍算，同时兜一个 52 物理 px 的下限（手环类设备摸得准的最小值）
    const btnH = Math.max(Math.round(fs * 3.0), Math.round(52 * (this.k || 1)))
    const g = Math.round(fs * 0.6)
    const panH = pad + padB + tipH + g + sliderH + g + btnH

    this.sAPanel = 'width:' + cw + 'px;height:' + panH + 'px;left:0;top:' + (ch - panH) +
      'px;border-width:1px;border-color:rgba(255,255,255,0.13);'
    this.sATip = 'width:' + cw + 'px;height:' + tipH + 'px;font-size:' + Math.round(fs * 0.82) +
      'px;line-height:' + tipH + 'px;'
    this.sSlider = 'width:' + cw + 'px;height:' + sliderH + 'px;margin-top:' + g + 'px;'

    const trackW = Math.round(cw * 0.78)
    const trackH = Math.max(5, Math.round(fs * 0.7))
    const left = Math.round((cw - trackW) / 2)
    const tTop = Math.round((sliderH - trackH) / 2)
    const kTop = Math.round((sliderH - knob) / 2)
    this.trackLeft = left
    this.trackW = trackW
    this.knobD = knob
    const r = (this.sizeR - SIZE_MIN) / (SIZE_MAX - SIZE_MIN)
    this.sTrack = 'width:' + trackW + 'px;height:' + trackH + 'px;left:' + left + 'px;top:' + tTop +
      'px;border-radius:' + Math.round(trackH / 2) + 'px;'
    this.sFill = 'width:' + Math.round(trackW * r) + 'px;height:' + trackH + 'px;left:' + left +
      'px;top:' + tTop + 'px;border-radius:' + Math.round(trackH / 2) + 'px;'
    this.sKnob = 'width:' + knob + 'px;height:' + knob + 'px;left:' +
      Math.round(left + r * (trackW - knob)) + 'px;top:' + kTop +
      'px;border-width:1px;border-color:rgba(255,255,255,0.55);border-radius:' + Math.round(knob / 2) + 'px;'

    this.sABtns = 'width:' + cw + 'px;height:' + btnH + 'px;margin-top:' + g + 'px;'
    const abtnW = Math.round(cw * 0.34)
    const abtnBase = 'width:' + abtnW + 'px;height:' + btnH +
      'px;border-width:1px;border-color:rgba(255,255,255,0.14);border-radius:' + Math.round(btnH * 0.5) + 'px;'
    this.sABtn = abtnBase + 'margin-left:' + Math.round(fs * 0.9) + 'px;'
    this.sABtn0 = abtnBase + 'margin-left:0px;'
    this.sABtnT = 'font-size:' + Math.round(fs * 0.9) + 'px;line-height:' + btnH + 'px;'
  },

  /* 顶栏/底栏该不该出现：表情包模式常驻，立绘模式长按才浮出来（调整面板打开时全藏起来） */
  syncChrome() {
    const showTop = this.emojiOn || (this.chromeOn && !this.adjusting)
    this.showBarNormal = this.emojiOn
    this.showBarTachie = this.tachieOn && this.chromeOn && !this.adjusting
    // 手环 10 不支持立绘 —— 底栏只剩设置键，别留个点不动的空位
    this.showSwap = this.canTachie
    this.noSwap = !this.canTachie
    // 立绘是自己的美术，浅色深色都可能 —— 顶栏底栏垫一层深色，白字才稳
    this.barCls = this.tachieOn ? 'tchar' : ''
    this.topWide = showTop && this.wide
    this.topNarrow = showTop && this.narrow
  },

  /* 切模式：emoji / tachie。改完要把文字排版和立绘几何都重算一遍 */
  setMode(m) {
    const tachie = (m === 'tachie') && this.canTachie
    this.mode = tachie ? 'tachie' : 'emoji'
    this.tachieOn = tachie
    this.emojiOn = !tachie
    this.chromeOn = false
    this.chromeTicks = 0
    if (!tachie) this.adjusting = false
    this.showBubble = true
    if (tachie) {
      this.tachieId = diffIdFor(this.expr)
      this.tachieSrc = tachiePath(this.tachieId)
    }
    this.syncChrome()
    this.layoutTachie()
    this.relayoutText()
  },

  /* 排版文字：全部台词统一走「逐字窗口跑马灯」滚动，不再区分长短 */
  relayoutText() {
    const fs = this.fs || 20
    // 立绘模式的气泡比表情包模式的窄一圈，窗口字数要跟着重算
    const bw = (this.tachieOn ? this.tbW : this.bubbleW) || 384
    const bh = (this.tachieOn ? this.tbH : this.bubbleH) || 52
    const full = this.fullText || ''
    let w = 0
    let fit = 0
    for (let i = 0; i < full.length; i++) {
      const c = full.charCodeAt(i)
      // 中文按 1 个 em 宽（以前按 0.95 算会多塞一个字，导致末尾被裁掉，看起来只显示 3/4）
      // 余量给到 1.2 个字号，吸收字体渲染比字号略宽的情况
      w += (c < 256 ? 0.55 : 1) * fs
      if (w <= bw - fs * 1.2) fit++
      else break
    }
    this.fitN = Math.max(1, fit)
    this.marquee = true
    this.marqPos = 0
    this.marqTick = 0
    const st = 'font-size:' + fs + 'px;line-height:' + bh +
      'px;height:' + bh + 'px;width:' + bw + 'px;text-align:left;'
    this.sText = st
    this.sTText = st

    // 短句：把台词重复拼成一条长字幕（句间留全角空格），
    // 这样滚动时永远有内容，不会出现大段空白（以前前后补空格会空掉一屏）
    let start = 0
    if (full.length <= this.fitN) {
      let src = full
      let guard = 0
      while (src.length < this.fitN + full.length + 2 && guard < 40) {
        src += '\u3000\u3000' + full
        guard++
      }
      this.scrollSrc = src
    } else {
      this.scrollSrc = full
    }
    this.marqPos = start
    this.dispText = this.windowAt(start)
  },

  /* 取滚动窗口：从 pos 开始取 fitN 个字，越界自动绕回 */
  windowAt(pos) {
    const src = this.scrollSrc || ''
    const n = this.fitN || 1
    if (!src.length) return ''
    let s = ''
    for (let i = 0; i < n; i++) {
      s += src[(pos + i) % src.length]
    }
    return s
  },

  /* ---------------- 循环 ---------------- */

  startLoop() {
    const self = this
    this.stopLoop()
    this.timer = setInterval(function () {
      self.tickOnce()
    }, TICK)
  },

  stopLoop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tickOnce() {
    this.tick++

    // 时钟：分钟变了才更新
    const c = this.fmtClock()
    if (c !== this.clock) this.clock = c

    // 表情逐帧播放
    if (this.animOn && this.tick % FRAME_TICKS === 0) {
      this.frame = (this.frame + 1) % framesOf(this.expr)
      this.emojiSrc = emojiPath(this.expr, this.frame)
    }

    // 全部台词逐字滚动（不依赖 scroll 组件）；速度跟随设置项
    if (this.marquee) {
      const step = this.speed >= 1.5 ? 1 : (this.speed <= 0.7 ? 3 : 2)
      this.marqTick++
      if (this.marqTick % step === 0) {
        this.marqPos++
        if (this.marqPos >= this.scrollSrc.length) this.marqPos = 0
        this.dispText = this.windowAt(this.marqPos)
      }
    }

    // 好感度浮字：显示 2 秒后消失
    if (this.affTip) {
      this.affTipTicks++
      if (this.affTipTicks > 34) this.affTip = ''
    }

    /* 换差分后抖一下：上下交替、幅度按剩余帧数线性衰减，8 帧（≈0.48 秒）后停住。
       静止时不写 style —— 立绘不动的时候没必要每帧重排。
       调整面板打开时立刻停住并归位，否则一边抖一边拖对不准。 */
    if (this.shakeTick > 0 && !this.adjusting) {
      this.shakeTick--
      const decay = this.shakeTick / SHAKE_TICKS
      const sgn = (this.shakeTick % 2 === 0) ? 1 : -1
      this.shakeY = Math.round(sgn * (this.ch || 540) * SHAKE_AMP * decay)
      this.renderTachie()
    } else if (this.shakeY !== 0) {
      this.shakeTick = 0
      this.shakeY = 0
      this.renderTachie()
    }

    // 立绘模式：长按浮出来的顶栏/底栏，5 秒没人碰就自动收起
    if (this.tachieOn && this.chromeOn && !this.adjusting) {
      this.chromeTicks++
      if (this.chromeTicks > CHROME_HOLD) {
        this.chromeOn = false
        this.syncChrome()
      }
    }

    // 长时间没人理，就自己说句话
    if (this.idleOn) {
      const now = new Date().getTime()
      if (now - this.lastAct > 45000) {
        this.lastAct = now
        this.say('chat')
      }
    }
  },

  /* ---------------- 交互 ---------------- */

  onTap() {
    // 拖动立绘之后抬手也会触发一次 click，这一下不当成「说话」
    if (this.dragMoved) {
      this.dragMoved = false
      return
    }
    if (this.adjusting) return
    this.lastAct = new Date().getTime()
    if (!this.welcomed) {
      this.welcomed = true
      this.setExpr('idle')
      this.sayText(this.pick(WELCOME))
      return
    }

    const d = new Date()
    const h = d.getHours() + d.getMinutes() / 60

    // 每个时段第一次点她 → 好感度 +1（每天最多 4 分）
    this.claimSlot(this.timeSlot())

    // 日期台词：概率刻意压得很低（以前 55%，几乎每次点都在说节日/周末）
    if (Math.random() < 0.14) {
      const ev = eventsOf(d)
      for (let i = 0; i < ev.length; i++) {
        const pool = DATE_LINES[ev[i]]
        if (pool && pool.length) return this.sayMood(pool, ['happy'])
      }
    }

    // 饭点（也降了，别老是催吃饭）
    if (Math.random() < 0.22) {
      if (h > 6.5 && h < 8.5) return this.say('breakfast')
      if (h > 10.5 && h < 12.5) return this.say('lunch')
      if (h > 16.5 && h < 18.5) return this.say('dinner')
    }

    const r = Math.random()
    if (r < 0.26) return this.say('expr')
    if (r < 0.46 && this.levelLv() >= 2) return this.say('bond')
    if (r < 0.60) return this.say('heart')
    if (r < 0.72) return this.say('song')
    if (r < 0.84) return this.say('chat')
    return this.say('time')
  },

  say(kind) {
    if (kind === 'expr') {
      const e = this.pickExpr()
      this.setExpr(e)
      const pool = EXPR_LINES[e] || EXPR_LINES.idle
      return this.sayText(this.pick(pool))
    }
    if (kind === 'bond') {
      const lv = this.levelLv()
      const pool = BOND_LINES[lv] || BOND_LINES[1]
      this.setExpr(lv >= 4 ? 'love' : (lv >= 3 ? 'shy' : 'happy'))
      return this.sayText(this.pick(pool))
    }
    if (kind === 'heart') {
      return this.sayMood(Math.random() < 0.75 ? HEART_LINES : CHEER_LINES, ['sad'])
    }
    if (kind === 'song') {
      return this.sayMood(SONG_LINES, ['sing'])
    }
    if (kind === 'chat') {
      return this.sayMood(CHAT_LINES, ['think'])
    }
    if (kind === 'time') {
      return this.sayMood(TIME_LINES[this.timeSlot()], ['happy'])
    }
    if (kind === 'breakfast' || kind === 'lunch' || kind === 'dinner') {
      return this.sayMood(MEAL_LINES[kind], ['eat'])
    }
    return this.sayMood(CHAT_LINES, ['think'])
  },

  /* 先挑台词，再按台词的情绪挑表情 —— 表情和内容是同一件事，不再各随机各的 */
  sayMood(pool, fallback) {
    const t = this.pick(pool)
    this.setExpr(exprFor(t, fallback))
    return this.sayText(t)
  },

  sayText(str) {
    this.fullText = (str || '').replace(/\{nick\}/g, this.nick)
    this.marqPos = 0
    this.marqTick = 0
    this.relayoutText()
  },

  setExpr(name) {
    this.expr = name
    this.frame = 0
    this.emojiSrc = emojiPath(name, 0)
    // 立绘模式：按情绪换差分图（没配 diff 就一直用 DEFAULT_ID）
    const id = diffIdFor(name)
    if (id !== this.tachieId) {
      this.tachieId = id
      this.tachieSrc = tachiePath(id)
      this.startShake()          // 换脸的同时抖一下，切换有「实感」
    }
  },

  /* ---------------- 立绘模式：长按 / 切换 / 调整 / 拖动 / 滑条 ---------------- */

  /* 长按屏幕：顶栏底栏浮出来（再长按一次收起）。表情包模式没有隐藏状态，忽略 */
  onLongPress() {
    if (!this.tachieOn || this.adjusting) return
    this.chromeOn = !this.chromeOn
    this.chromeTicks = 0
    this.syncChrome()
  },

  onToggleMode() {
    this.setMode(this.tachieOn ? 'emoji' : 'tachie')
    this.lastAct = new Date().getTime()
    this.saveViewState()
  },

  onAdjust() {
    if (!this.tachieOn) return
    this.adjusting = true
    this.showBubble = false
    this.chromeOn = false
    this.chromeTicks = 0
    this.shakeTick = 0
    this.shakeY = 0
    this.renderTachie()
    this.syncChrome()
    this.layoutAdjust()
  },

  onAdjustDone() {
    this.adjusting = false
    this.showBubble = true
    this.chromeOn = true
    this.chromeTicks = 0
    this.syncChrome()
    this.saveViewState()
  },

  /* 回到配置里的默认大小和位置（还没落盘，点「完成」才存） */
  onViewReset() {
    this.sizeR = DEFAULT_VIEW.size
    this.posX = DEFAULT_VIEW.x
    this.posY = DEFAULT_VIEW.y
    this.layoutTachie()
    this.layoutAdjust()
  },

  /* 拖动立绘：触摸坐标是物理 px，乘 k 换成设计 px 再折算成相对比例。
     立绘模式不用 onclick / onlongpress —— 同一个节点上混用原始触摸事件和手势，
     在 Vela 上容易互相吞掉。这里全部自己判。 */
  onDragStart(e) {
    const t = e && e.touches && e.touches[0]
    if (!t) return
    this.dragOn = true
    this.dragMoved = false
    this.longFired = false
    this.dragT0 = new Date().getTime()
    this.dragX = t.clientX * this.k
    this.dragY = t.clientY * this.k

    /* 长按挂定时器，到点立即触发 —— 不能等抬手再判「按了多久」，
       否则按住半秒还得把手指抬起来才有反应，手感是「迟钝」的。
       调整模式不挂：手指本来就要按住拖立绘，长按没有意义。 */
    this.clearLong()
    if (this.tachieOn && !this.adjusting) {
      const self = this
      this.longTimer = setTimeout(function () {
        self.longTimer = 0
        if (!self.dragOn || self.dragMoved) return
        self.longFired = true
        self.onLongPress()
      }, LONG_MS)
    }
  },

  /* 撤销长按判定（手指划走了 / 抬手了 / 页面销毁） */
  clearLong() {
    if (this.longTimer) {
      clearTimeout(this.longTimer)
      this.longTimer = 0
    }
  },

  onDragMove(e) {
    if (!this.dragOn) return
    const t = e && e.touches && e.touches[0]
    if (!t) return
    const x = t.clientX * this.k
    const y = t.clientY * this.k

    /* 非调整模式：移动本身没有功能，只用来撤销长按 ——
       手指明显划过去了就不该算「按住不动」。12 设计 px 的容差留给手抖。 */
    if (!this.adjusting) {
      if (Math.abs(x - this.dragX) > 12 || Math.abs(y - this.dragY) > 12) this.clearLong()
      return
    }

    const dx = x - this.dragX
    const dy = y - this.dragY
    if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return
    this.dragMoved = true
    this.clearLong()
    this.dragX = x
    this.dragY = y
    this.posX += dx / (this.cw || DW)
    this.posY += dy / (this.ch || 540)
    this.posX = Math.min(Math.max(this.posX, POS_LO), POS_HI)
    this.posY = Math.min(Math.max(this.posY, POS_LO), POS_HI)
    this.layoutTachie()
  },

  /* 抬手：长按已经在按住时触发过了 → 什么都不做（否则浮出按钮后立刻又冒一句台词）；
     拖动过 → 只存位置；调整中 → 什么都不做；否则当成点一下说话。 */
  onDragEnd() {
    if (!this.dragOn) return
    this.dragOn = false
    this.clearLong()
    if (this.longFired) {
      this.longFired = false
      return
    }
    if (this.dragMoved) {
      this.saveViewState()
      return
    }
    if (this.adjusting) return
    this.onTap()
  },

  onSliderStart(e) {
    this.sliderOn = true
    this.applySlider(e)
  },

  onSliderMove(e) {
    if (this.sliderOn) this.applySlider(e)
  },

  onSliderEnd() {
    if (!this.sliderOn) return
    this.sliderOn = false
    this.saveViewState()
  },

  applySlider(e) {
    const t = e && e.touches && e.touches[0]
    if (!t) return
    const x = t.clientX * this.k
    const w = this.trackW || 1
    let r = (x - this.trackLeft) / w
    r = Math.min(Math.max(r, 0), 1)
    this.sizeR = SIZE_MIN + r * (SIZE_MAX - SIZE_MIN)
    this.layoutTachie()
    this.layoutAdjust()
  },

  /* 把当前模式 / 大小 / 位置写进存档（拖动和滑条结束时才写，不是每帧） */
  saveViewState() {
    VIEW.mode = this.mode
    VIEW.size = this.sizeR
    VIEW.x = this.posX
    VIEW.y = this.posY
    saveView()
  },

  /* ---------------- 好感度 ---------------- */

  levelLv() {
    return this.level ? this.level.lv : 1
  },

  /* 启动时结算每日登录：加好感、说问候、再触发今天的消息 */
  bootAff() {
    const self = this
    dailyLogin(function (r) {
      self.applyAff(r.st)
      if (r.gain > 0 && !self.dev) self.showGain(r.gain)
      self.sayLogin(r)
      self.refreshInbox()
    })
  },

  /* 把一份好感度状态同步到界面（开发者模式下按满值显示） */
  applyAff(st) {
    if (!st) return
    this.affState = st
    this.dev = isDev(st)
    this.aff = effAff(st)
    this.level = levelOf(this.aff)
    this.updateAffUI()
  },

  /* 重新读一次好感度（现在读的是进程内那份，同步返回，不会读到旧存档） */
  refreshAff() {
    const self = this
    loadAff(function (st) { self.applyAff(st) })
  },

  sayLogin(r) {
    this.welcomed = true
    if (r.first) {
      this.setExpr('idle')
      this.sayText(this.pick(WELCOME))
      return
    }
    if (r.levelUp && !this.dev) {
      const pool = LEVEL_UP_LINES[r.levelUp.lv]
      this.setExpr('love')
      if (pool && pool.length) { this.sayText(this.pick(pool)); return }
    }
    if (r.comeback) {
      this.setExpr('sad')
      this.sayText(this.pick(LOGIN_LINES.comeback))
      return
    }
    if (r.gain === 0) {
      this.setExpr('happy')
      this.sayText(this.pick(LOGIN_LINES.again))
      return
    }
    this.setExpr('happy')
    const line = this.pick(LOGIN_LINES.streak)
    this.sayText(line.replace('{n}', '' + (r.streak || 1)))
  },

  /* 每个时段第一次点她 → +1；同步在本地记一笔，避免连点重复计数 */
  claimSlot(slot) {
    // v2.9.1：不再在页面里先 push 一次。
    // 现在 affinity.js 只有一份内存状态，touchSlot 内部就是同步判断 + 同步加，
    // 页面再记一笔反而会让 touchSlot 认为「这个时段已经领过」而不加分。
    const self = this
    touchSlot(slot, function (r) {
      self.applyAff(r.st)
      if (r.gain > 0 && !self.dev) self.showGain(r.gain)
      if (r.levelUp && !self.dev) {
        const pool = LEVEL_UP_LINES[r.levelUp.lv]
        if (pool && pool.length) {
          self.setExpr('love')
          self.sayText(self.pick(pool))
        }
      }
    })
  },

  showGain(n) {
    this.affTip = (n > 0 ? '+' : '') + n
    this.affTipTicks = 0
  },

  updateAffUI() {
    const lv = this.level || levelOf(this.aff || 0)
    this.affText = 'Lv.' + lv.lv + ' ' + (this.aff || 0)
    this.affCls = lv.lv >= 5 ? 'aff-hi' : (lv.lv >= 3 ? 'aff-mid' : 'aff-lo')
  },

  pickExpr() {
    const lv = this.levelLv()
    const pool = lv >= 3 ? EXPR : EXPR.filter(function (e) { return EXPR_HI.indexOf(e) < 0 })
    return this.pick(pool)
  },

  timeSlot() {
    const h = new Date().getHours()
    if (h >= 5 && h < 8) return 'dawn'
    if (h >= 8 && h < 11) return 'morning'
    if (h >= 11 && h < 13) return 'noon'
    if (h >= 13 && h < 17) return 'afternoon'
    if (h >= 17 && h < 20) return 'evening'
    if (h >= 20 && h < 23) return 'night'
    return 'late'
  },

  pick(arr) {
    if (!arr || !arr.length) return ''
    return arr[Math.floor(Math.random() * arr.length)]
  },

  fmtClock() {
    const d = new Date()
    const h = d.getHours()
    const m = d.getMinutes()
    return (h < 10 ? '0' + h : '' + h) + ':' + (m < 10 ? '0' + m : '' + m)
  },

  /* ---------------- 页面跳转 ---------------- */

  /* 刷新未读红点，并按「当前条件」掷一次骰子决定要不要冒新对话。
     每次登录（冷启动 / 回到前台）都有一次机会，但 8 分钟内不重复掷，
     免得在几个页面之间来回切就把每天的额度刷完。 */
  refreshInbox() {
    const now = new Date().getTime()
    if (now - lastTry < TRY_GAP) { this.refreshDot(); return }
    if (this._trigBusy) return                     // 防止 onInit / onShow 并发触发两次
    this._trigBusy = true
    lastTry = now
    const self = this
    maybeTrigger(function (st) {
      self._trigBusy = false
      self.hasUnread = unreadCount(st) > 0
    })
  },

  /* 只更新红点，不掷骰子 */
  refreshDot() {
    const self = this
    loadState(function (st) { self.hasUnread = unreadCount(st) > 0 })
  },

  onInbox() {
    this.stopLoop()
    try {
      router.push({ uri: '/pages/inbox' })
    } catch (e) {
      this.startLoop()
    }
  },

  /* 右滑退出。
     ★ 调整面板打开时、以及正在拖立绘时一律不退出 ——
     立绘放大后要左右拖着找位置，往右拖两下就退出去了，根本调不完。 */
  onSwipe(e) {
    if (this.adjusting || this.dragOn) return
    if (e && e.direction === 'right') this.onExit()
  },

  onSettings() {
    this.stopLoop()
    try {
      router.push({ uri: '/pages/settings' })
    } catch (e) {
      this.startLoop()
    }
  },

  onExit() {
    this.stopLoop()
    try {
      app.terminate()
    } catch (e) {}
  }

  /* v2.9.1：设置页的「表情动效 / 主动闲聊 / 文字速度」三项已按需求移除，
     这三项固定走默认值（动效开、主动闲聊开、速度中），不再读写设置存档。 */
}
</script>

