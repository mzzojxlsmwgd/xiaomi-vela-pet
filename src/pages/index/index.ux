    justify-content: center;
    width: 100%;
    flex-grow: 1;
  }

  .stage {
    position: relative;
    align-items: center;
    justify-content: center;
  }

  /* 表情外框：黑色毛玻璃 */
  .card {
    position: relative;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
  }

  .avatar {
    position: relative;
    object-fit: contain;
  }

  .bubble {
    position: relative;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
  }

  .bubble-text {
    position: relative;
    color: #f3f3f6;
    lines: 1;
  }

  .bottombar {
    position: relative;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
  }

  /* 立绘模式底栏：绝对定位贴底，不参与流布局 —— 键做大了也不会把上面的内容挤扁。
     ★ 必须用独立节点 + if 切换，不能靠动态 class 改 position：
       样式热更新只重算几何、不重建节点，实机上位置不会变。
     ★ 深色底衬写在这里而不是复用 .tchar —— .tchar 带 position:relative，
       两个类撞在一起时后定义的会盖掉 position:absolute。 */
  .bottombar-abs {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.62);
  }

  /* ---- 立绘模式 ---- */

  /* 浮在立绘上的顶栏/底栏底衬：rgba(0,0,0,.42) 在任何画面上都能压住白字 */
  .tchar {
    position: relative;
    background-color: rgba(0, 0, 0, 0.62);
  }

  /* 铺满画布的图层：立绘和气泡都绝对定位在里面，顶栏/底栏浮出来时立绘不会跳 */
  .tlayer {
    position: absolute;
    overflow: hidden;
  }

  .tachie {
    position: absolute;
    object-fit: contain;
  }

  .tbubble {
    position: absolute;
    justify-content: center;
    align-items: center;
    /* 立绘是自己的美术，浅色深色都可能 —— 气泡用深色玻璃，任何底上都看得清字 */
    background-color: rgba(0, 0, 0, 0.68);
  }

  .tbubble-text {
    position: relative;
    color: #f3f3f6;
    lines: 1;
  }

  /* ---- 调整面板 ---- */

  .apanel {
