  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
    background-color: #000000;
  }

  /* 纯黑底，不放光斑：模糊层在实机上看不出层次，反而糊成一片灰 */
  .topbar {
    position: relative;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
  }

  /* 窄屏：改成上下两行 —— 消息按钮一行，时间+好感一行 */
  .topbar-col {
    position: relative;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
  }

  /* 时间 + 好感胶囊这一排永远横着 */
  .row2 {
    position: relative;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
  }

  /* 黑色毛玻璃按钮：半透明白 + 1px 亮边 */
  .btn {
    position: relative;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
  }

  .dot {
    position: absolute;
    right: 0;
    top: 0;
    background-color: #ff4d4f;
  }

