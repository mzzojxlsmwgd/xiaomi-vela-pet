<template>
  <div class="page">
    <!-- 黑色毛玻璃底：高斯光斑（模糊已烘进 PNG，位置夹在画布内） -->
    <image class="glow" src="{{glowSrc}}" style="{{sGlow}}" />

    <div class="topbar" style="{{sTopbar}}">
      <div class="btn" style="{{sBtn}}" onclick="onBack">
        <image class="ico" src="/common/img/ic_back.png" style="{{sIco}}" />
      </div>
      <text class="title" style="{{sTitle}}">关于</text>
    </div>

    <scroll class="body" scroll-y="true" bounces="false" style="{{sBody}}">
      <text class="app" style="{{sApp}}">{{appName}}</text>
      <text class="ver" style="{{sLine}}">版本 {{ver}}</text>
      <text class="line" style="{{sLine}}">{{tagline}}</text>
      <text class="line" style="{{sLine}}">基于 Vela 快应用框架</text>
      <text class="line" style="{{sLine}}">MIT License · 可自由修改与分发</text>
      <text class="line" style="{{sLine}}">台词与剧情在 src/config/ 里填</text>
      <text class="tip" style="{{sTip}}">点一下角色开始互动</text>
      <div class="gap" style="{{sGap}}"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { TARGET } from '../../config/device-target.js'
import { GLOW_SRC, glowStyle } from '../../config/theme.js'
import { CHARACTER } from '../../config/character.js'

const DW = 480

export default {
  private: {
    ver: '1.0.0',
    appName: CHARACTER.appName,
    tagline: CHARACTER.tagline,
    sTopbar: '', sBtn: '', sIco: '', sTitle: '',
    sGlow: '', glowSrc: GLOW_SRC,
    sBody: '', sApp: '', sLine: '', sTip: '', sGap: ''
  },

  onInit() {
    this.apply(TARGET.W, TARGET.H)
  },

  apply(sw, sh) {
    if (!sw || !sh) return
    const k = DW / sw
    const ch = Math.round(sh * k)
    const btnPhys = Math.min(Math.max(sw * 0.105, 38), 56)
    const btn = Math.round(btnPhys * k)
    const ico = Math.round(btn * 0.5)
    const fsPhys = Math.min(Math.max(sw * 0.040, 12), 18)
    const fs = Math.round(fsPhys * k)
    const pad = Math.round(DW * 0.09)
    const topH = btn + pad

    this.sTopbar = 'height:' + topH + 'px;'
    this.sBtn = 'width:' + btn + 'px;height:' + btn + 'px;border-radius:' + Math.round(btn / 2) + 'px;'
    this.sIco = 'width:' + ico + 'px;height:' + ico + 'px;'
    this.sTitle = 'font-size:' + Math.round(fs * 1.1) + 'px;margin-left:' + Math.round(fs * 0.6) + 'px;'
    this.sBody = 'height:' + (ch - topH) + 'px;'
    this.sGlow = glowStyle(DW * 0.5, topH + (ch - topH) * 0.22, Math.round(DW * 1.2), DW, ch, 0.26)
    this.sApp = 'font-size:' + Math.round(fs * 1.5) + 'px;margin-bottom:' + Math.round(fs * 0.5) + 'px;'
    this.sLine = 'font-size:' + fs + 'px;margin-bottom:' + Math.round(fs * 0.45) + 'px;'
    this.sTip = 'font-size:' + Math.round(fs * 0.9) + 'px;margin-top:' + Math.round(fs * 0.8) + 'px;'
    this.sGap = 'height:' + Math.round(fs * 1.5) + 'px;'
  },

  onBack() {
    try {
      router.back()
    } catch (e) {}
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    position: relative;
    flex-direction: column;
    align-items: center;
    background-color: #000000;
  }

  /* 高斯光斑：模糊已烘进 PNG，这里只负责摆放与调暗 */
  .glow {
    position: absolute;
    object-fit: contain;
  }

  .topbar {
    position: relative;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .btn {
    position: relative;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
  }

  .ico {
    position: relative;
    object-fit: contain;
  }

  .title {
    position: relative;
    color: #f3f3f6;
    font-weight: bold;
  }

  .body {
    position: relative;
    flex-direction: column;
    align-items: center;
  }

  .app {
    position: relative;
    color: #f3f3f6;
    font-weight: bold;
    text-align: center;
  }

  .ver {
    position: relative;
    color: #8a8a93;
    text-align: center;
  }

  .line {
    position: relative;
    color: #b9b9c1;
    text-align: center;
  }

  .tip {
    position: relative;
    color: #8a8a93;
    text-align: center;
  }

  .gap {
    position: relative;
    width: 100%;
  }
</style>
