<template>
  <div class="page">
    <div class="topbar" style="{{sTopbar}}">
      <div class="btn" style="{{sBtn}}" onclick="onBack">
        <image class="ico" src="/common/img/ic_back.png" style="{{sIco}}" />
      </div>
      <text class="title" style="{{sTitle}}">关于</text>
    </div>

    <scroll class="body" scroll-y="true" bounces="false" style="{{sBody}}">
      <text class="app" style="{{sApp}}">{{appName}}</text>
      <text class="ver" style="{{sLine}}">版本 {{ver}}</text>
      <text class="line" style="{{sLine}}">{{tagline}}</text>
      <text class="line" style="{{sLine}}">基于 Vela 快应用框架</text>
      <text class="line" style="{{sLine}}">MIT License · 可自由修改与分发</text>
      <text class="line" style="{{sLine}}">台词与剧情在 src/config/ 里填</text>
      <text class="tip" style="{{sTip}}">点一下角色开始互动</text>
      <div class="gap" style="{{sGap}}"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import device from '@system.device'
import { TARGET } from '../../config/device-target.js'
import { CHARACTER } from '../../config/character.js'

const DW = 480

export default {
  private: {
    ver: '1.0.0',
    appName: CHARACTER.appName,
    tagline: CHARACTER.tagline,
    sTopbar: '', sBtn: '', sIco: '', sTitle: '',
    sBody: '', sApp: '', sLine: '', sTip: '', sGap: ''
  },

  onInit() {
    const self = this
    this.apply(TARGET.W, TARGET.H)          // 先用写死分辨率兜底
    // 再用设备真实屏幕精修 —— 手环 10 Pro 是 480×336 横屏，
    // 按写死的 432×514 算会把页面高度算成 571，下半截全在屏幕外
    try {
      device.getInfo({
        success(ret) {
          if (ret && ret.screenWidth && ret.screenHeight) {
            self.apply(ret.screenWidth, ret.screenHeight)
          }
        },
        fail() {}
      })
    } catch (e) {}
  },

  apply(sw, sh) {
    if (!sw || !sh) return
    const k = DW / sw
    const ch = Math.round(sh * k)
    // 横屏机型（手环 10 Pro 纵向只有 336）→ 字号和留白一起收紧，让介绍一屏放下
    const tight = ch < 420
    const btnPhys = Math.min(Math.max(sw * 0.105, 38), 56)
    const btn = Math.round(btnPhys * k)
    const ico = Math.round(btn * 0.5)
    const fsPhys = Math.min(Math.max(sw * (tight ? 0.034 : 0.040), 11), 18)
    const fs = Math.round(fsPhys * k)
    const pad = Math.round(DW * (tight ? 0.05 : 0.09))
    const topH = btn + pad

    this.sTopbar = 'height:' + topH + 'px;'
    this.sBtn = 'width:' + btn + 'px;height:' + btn + 'px;border-width:1px;border-color:rgba(255,255,255,0.13);border-radius:' + Math.round(btn / 2) + 'px;'
    this.sIco = 'width:' + ico + 'px;height:' + ico + 'px;'
    /* 每个 text 都显式给 line-height：不写就用设备默认行高（1.3~1.5 不定），
       在只有 336 高的横屏上多出来的那几像素就够把最后一行顶出屏幕了 */
    const titleFs = Math.round(fs * 1.1)
    const appFs = Math.round(fs * 1.5)
    const tipFs = Math.round(fs * 0.9)
    this.sTitle = 'font-size:' + titleFs + 'px;line-height:' + Math.round(titleFs * 1.3) +
      'px;margin-left:' + Math.round(fs * 0.6) + 'px;'
    this.sBody = 'height:' + (ch - topH) + 'px;'
    this.sApp = 'font-size:' + appFs + 'px;line-height:' + Math.round(appFs * 1.3) +
      'px;margin-bottom:' + Math.round(fs * (tight ? 0.3 : 0.5)) + 'px;'
    this.sLine = 'font-size:' + fs + 'px;line-height:' + Math.round(fs * 1.35) +
      'px;margin-bottom:' + Math.round(fs * (tight ? 0.28 : 0.45)) + 'px;'
    this.sTip = 'font-size:' + tipFs + 'px;line-height:' + Math.round(tipFs * 1.35) +
      'px;margin-top:' + Math.round(fs * (tight ? 0.5 : 0.8)) + 'px;'
    this.sGap = 'height:' + Math.round(fs * (tight ? 0.9 : 1.5)) + 'px;'
  },

  onBack() {
    try {
      router.back()
    } catch (e) {}
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    position: relative;
    flex-direction: column;
    align-items: center;
    background-color: #000000;
  }

  .topbar {
    position: relative;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .btn {
    position: relative;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
  }

  .ico {
    position: relative;
    object-fit: contain;
  }

  .title {
    position: relative;
    color: #f3f3f6;
    font-weight: bold;
  }

  .body {
    position: relative;
    flex-direction: column;
    align-items: center;
  }

  .app {
    position: relative;
    color: #f3f3f6;
    font-weight: bold;
    text-align: center;
  }

  .ver {
    position: relative;
    color: #8a8a93;
    text-align: center;
  }

  .line {
    position: relative;
    color: #b9b9c1;
    text-align: center;
  }

  .tip {
    position: relative;
    color: #8a8a93;
    text-align: center;
  }

  .gap {
    position: relative;
    width: 100%;
  }
</style>
