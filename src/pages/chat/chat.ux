<template>
  <div class="page" style="{{sPage}}">
    <div class="topbar" style="{{sTopbar}}">
      <div class="btn" style="{{sBtn}}" onclick="onBack">
        <image class="ico" src="/common/img/ic_back.png" style="{{sIco}}" />
      </div>
      <text class="title" style="{{sTitle}}">{{title}}</text>
    </div>

    <!-- 消息区：流式布局 + 整句显示（自动换行，不截断、不滚窗）。
         上下拖动可以翻看更早的消息。 -->
    <div class="msgwrap" style="{{sMsgWrap}}" ontouchstart="onTS" ontouchmove="onTM" ontouchend="onTE">
      <div class="mrow {{$item.rowCls}}" style="{{sRow}}" for="{{msgs}}" key="{{$item.k}}">
        <div class="bub {{$item.bubCls}}" style="{{sBub}}">
          <image class="bub-img" if="{{$item.exprSrc}}" src="{{$item.exprSrc}}" style="{{sBubImg}}" />
          <text class="bt" style="{{sBt}}">{{$item.disp}}</text>
        </div>
      </div>
    </div>

    <!-- 底部：输入中 / 选项 / 结局 -->
    <div class="bottom" style="{{sBottom}}">
      <text class="typing" if="{{showTyping}}" style="{{sTyping}}">{{typingHint}}</text>

      <!-- 选项对话框：外面一层大圆角玻璃面板，里面的选项尺寸不变 -->
      <div class="choicebox" if="{{showChoices}}" style="{{sChoiceBox}}">
        <div class="choice" style="{{sChoice}}" for="{{choices}}" key="{{$idx}}"
          onclick="onChoice($idx)">
          <text class="choice-t" style="{{sChoiceT}}">{{$item.text}}</text>
        </div>
      </div>

      <div class="endwrap" if="{{showEnd}}" style="{{sEndWrap}}">
        <text class="affchg" if="{{affText}}" style="{{sAffChg}}">{{affText}}</text>
        <div class="acts" style="{{sActs}}">
          <div class="act" style="{{sAct}}" onclick="onReplay">
            <text class="act-t" style="{{sActT}}">再玩一次</text>
          </div>
          <div class="act act-main" style="{{sAct}}" onclick="onBack">
            <text class="act-t" style="{{sActT}}">返回消息</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import device from '@system.device'
import { TARGET } from '../../config/device-target.js'
import { STORIES } from '../../config/stories.js'
import { OPEN_KEY, markRead, markDone } from '../../config/inbox.js'
import { storyReward, isDev } from '../../config/affinity.js'
import { getString } from '../../config/store.js'
import { emojiPath } from '../../config/emoji.js'
import { stickerFor } from '../../config/mood.js'
import { CHARACTER } from '../../config/character.js'

const DW = 480
const TICK = 60                 // 主循环 ms
const REVEAL_TICKS = 14         // 每 14 个 tick 冒一条（≈840ms，留够阅读时间）
const STICKER_CHANCE = 0.6      // 对方说话时夹带表情包的概率（挑哪张由台词情绪决定）

export default {
  private: {
    typingHint: CHARACTER.typingHint,
    sid: '',                     // 从 router params 接收的剧情 id
    title: '',
    storyId: '',
    story: null,
    stepId: '',
    score: 0,
    ended: false,
    history: [],                 // [{ who:'her'|'me', text }]
    queue: [],                   // 待冒出的台词
    msgs: [],                    // 当前渲染窗口
    choices: [],
    phase: 'typing',
    endingName: '',
    grade: '',
    affText: '',                 // 结局下方的好感度变化
    showTyping: true,
    showChoices: false,
    showEnd: false,
    tick: 0,
    sinceReveal: 0,
    scrollBack: 0,               // 往上翻了几条（0 = 贴底看最新）
    timer: null,
    // 拖动
    k: 1, tY: 0, tAcc: 0, tDragging: false,
    // 尺寸
    ch: 540, topH: 76, fs: 20, lineH: 28, padV: 8, padH: 12,
    textW: 312, msgAreaH: 400, exprH: 60,
    sPage: '', sTopbar: '', sBtn: '', sIco: '', sTitle: '',
    sMsgWrap: '', sRow: '', sBub: '', sBubImg: '', sBt: '', sBottom: '', sTyping: '',
    sChoiceBox: '', sChoice: '', sChoiceT: '', sEndWrap: '', sEnding: '', sAffChg: '',
    sActs: '', sAct: '', sActT: ''
  },

  onInit() {
    const self = this
    this.apply(TARGET.W, TARGET.H)          // 先用写死分辨率兜底
    // 再用设备真实屏幕精修 —— 否则装到手环 10 Pro（480×336 横屏）上，
    // 页面会按写死的 432×514 算高度，底部选项框和结局按钮全被切到屏幕外
    try {
      device.getInfo({
        success(ret) {
          if (ret && ret.screenWidth && ret.screenHeight) {
            self.apply(ret.screenWidth, ret.screenHeight)
          }
        },
        fail() {}
      })
    } catch (e) {}
    // ① 优先用 router params（同步传递，没有「写完就读」的竞态）
    const sid = this.sid || ''
    if (sid) { this.openStory(sid); return }
    // ② 兜底：读 storage（老路径 / params 丢失时）
    getString(OPEN_KEY, function (id) { self.openStory(id) })
  },

  onShow() { if (!this.timer) this.startLoop() },
  onHide() { this.stopLoop() },
  onDestroy() { this.stopLoop() },

  /* ---------------- 尺寸 ---------------- */

  apply(sw, sh) {
    if (!sw || !sh) return
    this.sw = sw
    this.sh = sh
    const k = DW / sw
    const ch = Math.round(sh * k)
    const btnPhys = Math.min(Math.max(sw * 0.1, 36), 52)
    const btn = Math.round(btnPhys * k)
    const ico = Math.round(btn * 0.5)
    const fsPhys = Math.min(Math.max(sw * 0.042, 12), 19)
    const fs = Math.round(fsPhys * k)
    const topH = btn + Math.round(fs * 1.6)

    this.k = k
    this.ch = ch
    this.topH = topH
    this.fs = fs
    this.lineH = Math.round(fs * 1.38)
    this.padV = Math.round(fs * 0.42)
    this.padH = Math.round(fs * 0.6)
    // 气泡外框宽 = 画布 70%，减去左右内边距才是文字宽度
    this.textW = Math.round(DW * 0.70) - this.padH * 2

    this.sPage = 'width:' + DW + 'px;height:' + ch + 'px;left:0;top:0;overflow:hidden;'
    this.sTopbar = 'height:' + topH + 'px;padding-left:' + Math.round(DW * 0.06) +
      'px;padding-right:' + Math.round(DW * 0.06) + 'px;'
    this.sBtn = 'width:' + btn + 'px;height:' + btn + 'px;border-width:1px;border-color:rgba(255,255,255,0.13);border-radius:' + Math.round(btn / 2) + 'px;'
    this.sIco = 'width:' + ico + 'px;height:' + ico + 'px;'
    // 标题：固定宽度（长标题原本会把返回键挤出屏幕）+ 显式行高（设备默认行高会撑高顶栏）
    const titleFs = Math.round(fs * 1.02)
    this.sTitle = 'font-size:' + titleFs + 'px;line-height:' + Math.round(titleFs * 1.3) +
      'px;margin-left:' + Math.round(fs * 0.6) +
      'px;width:' + Math.round(DW - btn * 2 - fs * 1.2) + 'px;text-align:center;'

    // 行：高度不写死（气泡按内容自适应），只固定间距
    this.sRow = 'width:' + DW + 'px;margin-top:' + Math.round(fs * 0.42) + 'px;'
    // 气泡：宽度写死、高度自适应；文字不限行数（默认 lines:-1）→ 整句都在，不会被截掉
    // 大圆角：1.5 倍字号（约等于气泡短边的一半，接近胶囊）
    this.sBub = 'width:' + this.textW + 'px;padding-top:' + this.padV + 'px;padding-bottom:' +
      this.padV + 'px;padding-left:' + this.padH + 'px;padding-right:' + this.padH +
      'px;border-width:1px;border-color:rgba(255,255,255,0.14);border-radius:' + Math.round(fs * 1.5) + 'px;'
    this.sBt = 'font-size:' + fs + 'px;line-height:' + this.lineH + 'px;width:' + this.textW + 'px;'
    // 夹带的表情包：正方形，宽度跟着字号走
    this.exprH = Math.round(fs * 3.0)
    this.sBubImg = 'width:' + this.exprH + 'px;height:' + this.exprH + 'px;border-width:1px;border-color:rgba(255,255,255,0.06);border-radius:' +
      Math.round(fs * 0.5) + 'px;margin-bottom:' + Math.round(fs * 0.3) + 'px;'

    const typingFs = Math.round(fs * 0.82)
    this.sTyping = 'font-size:' + typingFs + 'px;line-height:' + Math.round(typingFs * 1.35) + 'px;'

    /* 选项框：外面套一层大圆角玻璃面板，里面每个选项是胶囊。
       具体高度按「最长那条文字要不要折行」算，见 layoutChoices()。 */
    this.layoutChoices()
    const endFs = Math.round(fs * 0.86)
    const affcFs = Math.round(fs * 0.78)
    this.sEnding = 'font-size:' + endFs + 'px;line-height:' + Math.round(endFs * 1.35) +
      'px;margin-bottom:' + Math.round(fs * 0.4) + 'px;'
    this.sAffChg = 'font-size:' + affcFs + 'px;line-height:' + Math.round(affcFs * 1.35) +
      'px;margin-bottom:' + Math.round(fs * 0.4) + 'px;'
    this.sActs = 'width:' + DW + 'px;flex-direction:row;justify-content:center;align-items:center;'
    this.sAct = 'width:' + Math.round(DW * 0.38) + 'px;height:' + Math.round(fs * 2.5) +
      'px;border-width:1px;border-color:rgba(255,255,255,0.12);border-radius:' + Math.round(fs * 1.25) + 'px;margin-left:' + Math.round(DW * 0.02) +
      'px;margin-right:' + Math.round(DW * 0.02) + 'px;'
    const actFs = Math.round(fs * 0.9)
    this.sActT = 'font-size:' + actFs + 'px;line-height:' + Math.round(actFs * 1.3) + 'px;'

    this.layoutBottom()
    this.rebuild()
  },

  bottomHeight(fs) {
    if (this.phase === 'choices') {
      const n = this.choices.length || 2
      const optH = this.optH || Math.round(fs * 2.9)
      const optGap = this.optGap || Math.round(fs * 0.32)
      const boxPad = this.boxPad || Math.round(fs * 0.5)
      // 圆角面板上下各 boxPad，里面 n 个选项（含各自的下间距）
      return boxPad * 2 + n * (optH + optGap) + Math.round(fs * 0.3)
    }
    if (this.phase === 'end') {
      // 结算只显示好感增加量 + 两个按钮（结局名不再显示）
      return Math.round(fs * 0.78) + Math.round(fs * 0.4) +
        Math.round(fs * 2.5) + Math.round(fs * 1.2)
    }
    return Math.round(fs * 2.6)
  },

  /* 选项框：宽度固定，高度按最长那条文字决定要几行 ——
     以前高度写死 2.5 字号，遇到稍长的选项就被裁成半行（「有些选项显示不全」）。
     现在框宽收到 76%、字号收到 0.76、内边距一起收，长句也能整句显示。 */
  layoutChoices() {
    const fs = this.fs
    const optW = Math.round(DW * 0.76)
    const optFs = Math.max(11, Math.round(fs * 0.76))
    const optPadH = Math.round(fs * 0.42)
    /* 横屏机型（手环 10 Pro 只有 336 高）如果选项还按大字撑，消息区就只剩几十像素 ——
       整块挤在一起。这里把高度和间距一起收紧，换回一百多像素的消息区。 */
    const tight = this.ch < 420
    const optPadV = Math.round(fs * (tight ? 0.34 : 0.46))
    const optGap = Math.round(fs * (tight ? 0.18 : 0.26))
    const boxPad = Math.round(fs * (tight ? 0.28 : 0.36))
    const innerW = optW - optPadH * 2
    /* 每行字数按 1.24em 估：中文字宽本身是 1em，但字体字距 + 标点挤压会让实际占位变宽。 */
    const perLine = Math.max(1, Math.floor(innerW / (optFs * 1.24)))

    // 当前这组选项里最长的一条，决定要留几行
    let maxLen = 0
    for (let i = 0; i < this.choices.length; i++) {
      const t = (this.choices[i] && this.choices[i].text) || ''
      if (t.length > maxLen) maxLen = t.length
    }
    const lines = Math.min(3, Math.max(1, Math.ceil(maxLen / perLine)))
    const lineH = Math.round(optFs * 1.42)
    /* 高度 = 行数 × 行高 + 上下内边距 + 4px 余量（设备实际行高可能比 lineH 高一点点）。 */
    const optH = Math.max(Math.round(fs * (tight ? 2.0 : 2.2)), lines * lineH + optPadV * 2 + 4)

    this.optW = optW
    this.optH = optH
    this.optGap = optGap
    this.boxPad = boxPad

    this.sChoiceBox = 'width:' + (optW + boxPad * 2) + 'px;padding-top:' + boxPad +
      'px;padding-bottom:' + boxPad + 'px;padding-left:' + boxPad + 'px;padding-right:' + boxPad +
      'px;border-width:1px;border-color:rgba(255,255,255,0.10);border-radius:' + Math.round(optH * 0.5) + 'px;'
    /* 选项框不用 padding 留白：改成「框宽固定 + 内部文字定宽」——
       快应用的 width 到底是 border-box 还是 content-box 各机型不一致，
       加 padding 会把框撑出 choicebox，左右被裁。 */
    this.sChoice = 'width:' + optW + 'px;height:' + optH + 'px;border-width:1px;border-color:rgba(255,255,255,0.16);border-radius:' +
      Math.round(optH / 2) + 'px;margin-bottom:' + optGap + 'px;'
    /* 行数只能走样式里的 lines —— text 组件没有 lines 属性（写上会编译报错）。 */
    this.sChoiceT = 'font-size:' + optFs + 'px;line-height:' + lineH +
      'px;width:' + innerW + 'px;text-align:center;lines:' + lines + ';'
  },

  layoutBottom() {
    const bottomH = this.bottomHeight(this.fs)
    // 顶栏 + 消息区 + 底部 = 画布高，页面绝不溢出
    this.msgAreaH = Math.max(40, this.ch - this.topH - bottomH)
    this.sBottom = 'height:' + bottomH + 'px;width:' + DW + 'px;'
    this.sMsgWrap = 'height:' + this.msgAreaH + 'px;width:' + DW + 'px;'
    this.sEndWrap = 'width:' + DW + 'px;'
  },

  /* ---------------- 剧情 ---------------- */

  openStory(id) {
    let st = null
    for (let i = 0; i < STORIES.length; i++) {
      if (STORIES[i].id === id) st = STORIES[i]
    }
    if (!st) st = STORIES[0]

    this.story = st
    this.storyId = st.id
    this.title = st.title
    this.stepId = st.start
    this.score = 0
    this.ended = false
    this.history = []
    this.queue = []
    this.choices = []
    this.endingName = ''
    this.grade = ''
    this.tick = 0
    this.sinceReveal = 0
    this.scrollBack = 0
    this.phase = 'typing'

    markRead(st.id)
    // 用「当前真实分辨率」重排，不能拿 TARGET 写死值 ——
    // 否则 getInfo 精修过的尺寸一进聊天页就被覆盖回 432×514
    this.apply(this.sw || TARGET.W, this.sh || TARGET.H)
    this.setPhase('typing')
    this.enterStep(st.start)
    this.startLoop()
  },

  enterStep(id) {
    const step = this.story.steps[id]
    if (!step) { this.finish(); return }
    this.stepId = id
    const lines = step.say || []
    for (let i = 0; i < lines.length; i++) this.queue.push(lines[i])
    this.setPhase('typing')
  },

  setPhase(p) {
    this.phase = p
    this.showTyping = (p === 'typing')
    this.showChoices = (p === 'choices')
    this.showEnd = (p === 'end')
    if (p === 'choices') this.layoutChoices()   // 选项文字变了，高度要重算
    this.layoutBottom()
    this.rebuild()
  },

  startLoop() {
    const self = this
    this.stopLoop()
    this.timer = setInterval(function () { self.tickOnce() }, TICK)
  },

  stopLoop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tickOnce() {
    this.tick++
    if (!this.queue.length) return
    this.sinceReveal++
    if (this.sinceReveal < REVEAL_TICKS) return
    this.sinceReveal = 0
    // 夹带一张表情包：跟着这条消息一起出现，rebuild 时位置固定不变
    const line = this.queue.shift()
    this.history.push({ who: 'her', text: line, expr: this.rollSticker(line) })
    // 正在上翻看旧消息时，新消息进来不动视野（保持锚点）
    if (this.scrollBack > 0) this.scrollBack++
    this.rebuild()
    if (!this.queue.length) {
      if (this.ended) this.setPhase('end')
      else this.afterSay()
    }
  },

  /* 掷一次：要不要夹带表情，夹带哪一张 —— 由这句台词的情绪决定（见 config/mood.js）
     彩蛋里说话的可能不是角色本人，不该配角色的脸，直接不给贴纸。 */
  rollSticker(line) {
    if (this.story && this.story.noSticker) return ''
    return stickerFor(line, STICKER_CHANCE)
  },

  afterSay() {
    const step = this.story.steps[this.stepId]
    if (!step) { this.finish(); return }
    if (step.finish) { this.finish(); return }
    if (step.choices && step.choices.length) {
      this.choices = step.choices
      this.setPhase('choices')
      return
    }
    if (step.next) { this.enterStep(step.next); return }
    this.finish()
  },

  onChoice(idx) {
    if (this.phase !== 'choices') return
    const c = this.choices[idx]
    if (!c) return
    this.history.push({ who: 'me', text: c.text })
    this.score += (c.score || 0)
    this.choices = []
    this.sinceReveal = 0
    this.scrollBack = 0
    this.setPhase('typing')
    this.enterStep(c.next)
  },

  finish() {
    if (this.ended) return
    this.ended = true
    const st = this.story
    let grade = 'normal'
    if (this.score >= 2) grade = 'good'
    else if (this.score <= -1) grade = 'bad'
    const e = (st.endings && st.endings[grade]) || { name: '结局', say: ['……'] }
    this.grade = grade
    this.endingName = e.name
    this.affText = ''
    const lines = e.say || []
    for (let i = 0; i < lines.length; i++) this.queue.push(lines[i])
    this.setPhase('typing')
    // 彩蛋通关会自动放出最终消息（逻辑在 inbox.markDone 里，页面不用管）
    markDone(st.id, grade)

    // 彩蛋不结算好感度：都满级了，加减都没意义，也不该冒出「好感没变哦」
    if (st.noReward) {
      this.affText = ''
      this.layoutBottom()
      return
    }

    // 好感度结算：首次通关按选项分数给，重玩只有刷新最好结局才给一半
    const self = this
    storyReward(st.id, grade, this.score, function (r) {
      if (isDev(r.st)) {
        self.affText = '开发者模式 · 好感已满'
        self.layoutBottom()
        return
      }
      let t = ''
      if (r.delta > 0) t = '好感 +' + r.delta
      else if (r.delta < 0) t = '好感 ' + r.delta
      else t = '好感没变哦'
      if (!r.first) t = '重玩 · ' + t
      if (r.levelUp) t = t + ' · 升到 Lv.' + r.levelUp.lv
      self.affText = t
      self.layoutBottom()
    })
  },

  onReplay() { this.openStory(this.storyId) },

  onBack() {
    this.stopLoop()
    try {
      router.back()
    } catch (e) {
      this.startLoop()
    }
  },

  /* ---------------- 拖动翻看历史 ---------------- */

  onTS(e) {
    const t = e && e.touches && e.touches[0]
    if (!t) return
    this.tY = t.clientY
    this.tAcc = 0
    this.tDragging = true
  },

  onTM(e) {
    if (!this.tDragging) return
    const t = e && e.touches && e.touches[0]
    if (!t) return
    // 触摸坐标是物理 px，换算成设计 px（480 宽画布）
    this.tAcc += (t.clientY - this.tY) * this.k
    this.tY = t.clientY
    const unit = Math.round(this.fs * 2.2)
    if (Math.abs(this.tAcc) < unit) return
    // 手指下滑 → 看更早的消息；上滑 → 回到最新
    const step = this.tAcc > 0 ? 1 : -1
    this.tAcc = 0
    const maxBack = Math.max(0, this.history.length - 1)
    const nb = Math.max(0, Math.min(maxBack, this.scrollBack + step))
    if (nb !== this.scrollBack) {
      this.scrollBack = nb
      this.rebuild()
    }
  },

  onTE() {
    this.tDragging = false
    this.tAcc = 0
  },

  /* ---------------- 渲染 ---------------- */

  /* 每行大约能放几个字（中文按 1 em 算，留 12% 余量，宁可少算也别让真实换行多一行） */
  charsPerLine() {
    return Math.max(1, Math.floor(this.textW / (this.fs * 1.12)))
  },

  /* 估算一条消息占多高（只用来决定「这一屏能放几条」，真实高度由布局引擎算） */
  estHeight(text, expr) {
    const per = this.charsPerLine()
    const n = Math.min(4, Math.max(1, Math.ceil((text || '').length / per)))
    // 夹带了表情包的气泡要多算「表情高度 + 它与文字之间的间距」
    const extra = expr ? this.exprH + Math.round(this.fs * 0.3) : 0
    return n * this.lineH + this.padV * 2 + Math.round(this.fs * 0.42) + extra
  },

  /* 从最新往回数，凑满一屏能放下的条数；scrollBack 表示往上翻了几条 */
  rebuild() {
    if (!this.story) return
    const h = this.history
    if (!h.length) { this.msgs = []; return }

    let back = this.scrollBack
    if (back > h.length - 1) back = Math.max(0, h.length - 1)

    const end = h.length - back        // 窗口右边界（不含）
    // 留一行余量：估算总比真实排版保守一点，避免最上面一条被裁
    const budget = this.msgAreaH - this.lineH
    let sum = 0
    let from = end
    for (let i = end - 1; i >= 0; i--) {
      const eh = this.estHeight(h[i].text, h[i].expr)
      if (sum + eh > budget && from < end) break
      sum += eh
      from = i
    }

    const out = []
    for (let i = from; i < end; i++) {
      const m = h[i]
      const her = m.who === 'her'
      out.push({
        k: 'm' + i,
        disp: m.text,
        exprSrc: m.expr ? emojiPath(m.expr, 0) : '',
        rowCls: her ? 'mrow-her' : 'mrow-me',
        bubCls: her ? 'bub-her' : 'bub-me'
      })
    }
    this.msgs = out
  }
}
</script>

