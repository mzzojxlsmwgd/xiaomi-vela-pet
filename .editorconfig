# 统一编辑器行为，避免不同机器上产生无意义的 diff
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,json,ux,md,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown 里行尾两个空格是硬换行，不能删
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,webp,rpk}]
# 二进制文件不需要这些规则
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
